# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Markdown and documentation
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf

# Source code
*.ino text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.stl binary
*.step binary
*.stp binary
